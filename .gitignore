# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Production
*.tsbuildinfo
next-env.d.ts

# Environment variables. Broad on purpose: .env and .env*.local alone would have
# left .env.development and .env.production tracked. The negation keeps a
# committed example file possible without weakening the rule.
.env*
!.env.example

# Vercel
.vercel

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Claude Code — personal overrides stay local, shared project settings are committed
.claude/settings.local.json

# Superpowers brainstorming session artifacts (mockups, server state)
.superpowers/

# Playwright MCP artifacts and stray verification screenshots at repo root.
# The leading slash keeps public/*.png (real project images) tracked.
.playwright-mcp/
/*.png

# Working documents: the design spec, build plan and verification audit. Kept in
# the working copy, deliberately not published.
docs/
